<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="560.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial3.viewController.ClienteViewController">
    <children>
        <SplitPane dividerPositions="0.38" orientation="VERTICAL" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <Label layoutX="145.0" layoutY="15.0" text="Gestión Clientes">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label layoutX="40.0" layoutY="65.0" text="Documento:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label layoutX="40.0" layoutY="105.0" text="Nombre:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtDocumento" layoutX="145.0" layoutY="62.0" prefWidth="250.0" />
                        <TextField fx:id="txtNombre" layoutX="145.0" layoutY="102.0" prefWidth="250.0" />
                        <Button fx:id="btnAgregarCliente" layoutX="145.0" layoutY="150.0" mnemonicParsing="false" onAction="#onAgregarCliente" text="Agregar cliente" />
                        <Button fx:id="btnLimpiar" layoutX="275.0" layoutY="150.0" mnemonicParsing="false" onAction="#onLimpiar" text="Limpiar" />
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <TableView fx:id="tblListCliente" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                            <columns>
                                <TableColumn fx:id="tbcDocumento" prefWidth="180.0" text="Documento" />
                                <TableColumn fx:id="tbcNombre" prefWidth="240.0" text="Nombre" />
                            </columns>
                        </TableView>
                        <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#onVolver" text="Volver al menú" AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
