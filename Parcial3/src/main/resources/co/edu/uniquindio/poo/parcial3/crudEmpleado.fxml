<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="640.0" prefWidth="620.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial3.viewController.EmpleadoViewController">
    <children>
        <SplitPane dividerPositions="0.53" orientation="VERTICAL" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <Label layoutX="215.0" layoutY="15.0" text="Gestión Empleados">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label layoutX="90.0" layoutY="60.0" text="Tipo:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label layoutX="90.0" layoutY="97.0" text="Nombre:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label layoutX="90.0" layoutY="134.0" text="Documento:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label layoutX="90.0" layoutY="171.0" text="Código:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label layoutX="90.0" layoutY="208.0" text="Minutos:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label layoutX="90.0" layoutY="245.0" text="Caja:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbTipo" layoutX="200.0" layoutY="57.0" prefWidth="280.0" promptText="Seleccione el tipo" />
                        <TextField fx:id="txtNombre" layoutX="200.0" layoutY="94.0" prefWidth="280.0" />
                        <TextField fx:id="txtDocumento" layoutX="200.0" layoutY="131.0" prefWidth="280.0" />
                        <TextField fx:id="txtCodigo" layoutX="200.0" layoutY="168.0" prefWidth="280.0" />
                        <TextField fx:id="txtMinutos" layoutX="200.0" layoutY="205.0" prefWidth="280.0" promptText="Minutos disponibles" />
                        <TextField fx:id="txtCaja" layoutX="200.0" layoutY="242.0" prefWidth="280.0" promptText="Solo para cajero" />
                        <Button fx:id="btnAgregarEmpleado" layoutX="200.0" layoutY="288.0" mnemonicParsing="false" onAction="#onAgregarEmpleado" text="Agregar empleado" />
                        <Button fx:id="btnLimpiar" layoutX="340.0" layoutY="288.0" mnemonicParsing="false" onAction="#onLimpiar" text="Limpiar" />
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <TableView fx:id="tblListEmpleado" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                            <columns>
                                <TableColumn fx:id="tbcTipo" prefWidth="160.0" text="Tipo" />
                                <TableColumn fx:id="tbcCodigo" prefWidth="100.0" text="Código" />
                                <TableColumn fx:id="tbcNombre" prefWidth="180.0" text="Nombre" />
                                <TableColumn fx:id="tbcMinutos" prefWidth="150.0" text="Minutos disponibles" />
                            </columns>
                        </TableView>
                        <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#onVolver" text="Volver al menú" AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
