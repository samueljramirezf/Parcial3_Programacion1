<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="640.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.parcial3.viewController.PedidoViewController">
    <children>
        <SplitPane dividerPositions="0.3" orientation="VERTICAL" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <Label layoutX="465.0" layoutY="12.0" text="Gestión Pedidos">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label layoutX="60.0" layoutY="60.0" text="Código:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtCodigo" layoutX="160.0" layoutY="57.0" prefWidth="220.0" />
                        <Label layoutX="440.0" layoutY="60.0" text="Cliente:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbCliente" layoutX="540.0" layoutY="57.0" prefWidth="250.0" promptText="Seleccione el cliente" />
                        <Label layoutX="60.0" layoutY="102.0" text="Tipo de pan:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cmbTipoPan" layoutX="160.0" layoutY="99.0" prefWidth="220.0" promptText="Seleccione el tipo" />
                        <Label layoutX="440.0" layoutY="102.0" text="Cantidad:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtCantidad" layoutX="540.0" layoutY="99.0" prefWidth="250.0" promptText="Número de panes" />
                        <Button fx:id="btnRegistrar" layoutX="840.0" layoutY="57.0" mnemonicParsing="false" onAction="#onRegistrarPedido" prefWidth="140.0" text="Registrar" />
                        <Button fx:id="btnLimpiar" layoutX="840.0" layoutY="99.0" mnemonicParsing="false" onAction="#onLimpiar" prefWidth="140.0" text="Limpiar" />
                    </children>
                </AnchorPane>
                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <Label layoutX="10.0" layoutY="8.0" text="Pedidos (historial completo)">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TableView fx:id="tblListPedido" layoutX="10.0" layoutY="32.0" prefHeight="360.0" prefWidth="720.0">
                            <columns>
                                <TableColumn fx:id="tbcCodigo" prefWidth="70.0" text="Código" />
                                <TableColumn fx:id="tbcCliente" prefWidth="120.0" text="Cliente" />
                                <TableColumn fx:id="tbcTipoPan" prefWidth="105.0" text="Tipo de pan" />
                                <TableColumn fx:id="tbcCantidad" prefWidth="70.0" text="Cantidad" />
                                <TableColumn fx:id="tbcEstado" prefWidth="95.0" text="Estado" />
                                <TableColumn fx:id="tbcPanadero" prefWidth="125.0" text="Panadero asignado" />
                                <TableColumn fx:id="tbcMinutosReservados" prefWidth="125.0" text="Minutos reservados" />
                            </columns>
                        </TableView>
                        <Button fx:id="btnAsignar" layoutX="10.0" layoutY="402.0" mnemonicParsing="false" onAction="#onAsignarPedido" prefWidth="140.0" text="Asignar" />
                        <Button fx:id="btnCancelar" layoutX="160.0" layoutY="402.0" mnemonicParsing="false" onAction="#onCancelarPedido" prefWidth="140.0" text="Cancelar" />
                        <Label layoutX="750.0" layoutY="8.0" text="Empleados (minutos disponibles)">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <TableView fx:id="tblListEmpleado" layoutX="750.0" layoutY="32.0" prefHeight="360.0" prefWidth="340.0">
                            <columns>
                                <TableColumn fx:id="tbcEmpTipo" prefWidth="130.0" text="Tipo" />
                                <TableColumn fx:id="tbcEmpCodigo" prefWidth="55.0" text="Código" />
                                <TableColumn fx:id="tbcEmpNombre" prefWidth="85.0" text="Nombre" />
                                <TableColumn fx:id="tbcEmpMinutos" prefWidth="65.0" text="Minutos" />
                            </columns>
                        </TableView>
                        <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#onVolver" text="Volver al menú" AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="10.0" />
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
